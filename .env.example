# === Providers (switchable) ===
# Published Cursor Apps: bind SKILL_LAB_CURSOR_KEY (CURSOR_* is reserved by the host)
SKILL_LAB_CURSOR_KEY=

# Local-only fallbacks (optional on this machine; do not bind CURSOR_API_KEY for publish)
CURSOR_API_KEY=

# OpenAI-compatible Agent (OpenAI / DeepSeek / Tongyi / Moonshot / gateway)
OPENAI_API_KEY=
LLM_API_KEY=
DEEPSEEK_API_KEY=

# Compatible endpoint defaults (override per provider as needed)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Cursor default model when using Cursor provider (override with AI_MODEL if desired)
# AI_MODEL=composer-2.5

AGENT_MAX_ITERATIONS=25
RUN_PROVIDER=auto

# Optional skill roots / writable workspace
SKILL_LAB_PERSONAL_DIR=
# Hosted apps: set to a writable path (defaults to TMPDIR|/tmp/skill-lab when cwd is read-only)
SKILL_LAB_WORKSPACE=
SKILL_LAB_DATA_DIR=

# DeepSeek example (optional OpenAI-compatible backend):
# AI_PROVIDER path via RUN_PROVIDER=openai
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=
